graph TD
    A[SLEEP] --> B{TRIGGER}
    B -->|WakeWord| C[LISTENING]
    B -->|Button| D[AUDIO_CONTROL]
    C --> E[PROCESSING]
    E --> F{ACTION}
    F -->|Music| G[AUDIO_PLAY]
    F -->|Other| H[EXECUTE_TASK]
    G --> I[MUSIC_PLAYING]
    I --> J{EVENT}
    J -->|Finish| A
    J -->|Pause| K[MUSIC_PAUSED]
    J -->|Next| L[NEXT_TRACK]
    J -->|Volume| M[VOLUME_CONTROL]
    J -->|Stop| A
    K --> I
    L --> I
    M --> I
