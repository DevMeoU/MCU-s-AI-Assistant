# Menu chính của Trợ lý Xiaozhi (Được tùy chỉnh bởi Deesol)
# Main menu for Xiaozhi Assistant (Customized by Deesol)
menu "Xiaozhi Assistant (Custom by Deesol)"

# Cấu hình URL cho OTA (Over-The-Air) - Cập nhật firmware qua mạng
# OTA URL configuration for firmware updates over the air
config OTA_URL
    string "Default OTA URL"
    default "https://api.tenclass.net/xiaozhi/ota/"
    help
        The application will access this URL to check for new firmwares and server address.
        # Ứng dụng sẽ truy cập URL này để kiểm tra firmware mới và địa chỉ máy chủ.
        # Đây là đường dẫn mặc định cho cập nhật tự động qua mạng.

# Lựa chọn tài nguyên (assets) để nạp vào Flash
# Choice for selecting assets to flash into memory
choice
    prompt "Flash Assets"
    default FLASH_DEFAULT_ASSETS
    help
        Select the assets to flash.
        # Lựa chọn tài nguyên để nạp vào bộ nhớ Flash.
        # Tài nguyên có thể bao gồm hình ảnh, âm thanh, font chữ, v.v.

    config FLASH_NONE_ASSETS
        bool "Do not flash assets"
        # Không nạp tài nguyên - Tiết kiệm bộ nhớ Flash
        # Do not flash assets - Save Flash memory
    config FLASH_DEFAULT_ASSETS
        bool "Flash Default Assets"
        # Nạp tài nguyên mặc định - Cài đặt cơ bản
        # Flash default assets - Basic installation
    config FLASH_CUSTOM_ASSETS
        bool "Flash Custom Assets"
        # Nạp tài nguyên tùy chỉnh - Cho phép người dùng tự định nghĩa
        # Flash custom assets - Allow user-defined resources
endchoice

# Cấu hình file tài nguyên tùy chỉnh
# Custom assets file configuration
config CUSTOM_ASSETS_FILE
    depends on FLASH_CUSTOM_ASSETS
    string "Custom Assets File"
    default "assets.bin"
    help
        The custom assets file to flash.
        It can be a local file relative to the project directory or a remote url.
        # File tài nguyên tùy chỉnh để nạp vào Flash.
        # Có thể là file cục bộ trong thư mục dự án hoặc URL từ xa.
        # Định dạng file thường là .bin chứa dữ liệu tài nguyên như hình ảnh, âm thanh, font.

# Lựa chọn ngôn ngữ mặc định cho thiết bị
# Default language selection for device interface
choice
    prompt "Default Language"
    default LANGUAGE_ZH_CN
    help
        Select device display language
        # Lựa chọn ngôn ngữ hiển thị cho thiết bị.
        # Ngôn ngữ này sẽ được sử dụng cho menu, thông báo và giao diện người dùng.

    config LANGUAGE_ZH_CN
        bool "Chinese"
        # Tiếng Trung Quốc (Giản thể) - Ngôn ngữ mặc định
        # Chinese (Simplified) - Default language
    config LANGUAGE_ZH_TW
        bool "Chinese Traditional"
        # Tiếng Trung Quốc (Phồn thể)
        # Chinese (Traditional)
    config LANGUAGE_EN_US
        bool "English"
        # Tiếng Anh (Mỹ)
        # English (US)
    config LANGUAGE_JA_JP
        bool "Japanese"
        # Tiếng Nhật
        # Japanese
    config LANGUAGE_KO_KR
        bool "Korean"
        # Tiếng Hàn
        # Korean
    config LANGUAGE_VI_VN
        bool "Vietnamese"
        # Tiếng Việt - Ngôn ngữ bản địa
        # Vietnamese - Native language
    config LANGUAGE_TH_TH
        bool "Thai"
        # Tiếng Thái
        # Thai
    config LANGUAGE_DE_DE
        bool "German"
        # Tiếng Đức
        # German
    config LANGUAGE_FR_FR
        bool "French"
        # Tiếng Pháp
        # French
    config LANGUAGE_ES_ES
        bool "Spanish"
        # Tiếng Tây Ban Nha
        # Spanish
    config LANGUAGE_IT_IT
        bool "Italian"
        # Tiếng Ý
        # Italian
    config LANGUAGE_RU_RU
        bool "Russian"
        # Tiếng Nga
        # Russian
    config LANGUAGE_AR_SA
        bool "Arabic"
        # Tiếng Ả Rập
        # Arabic
    config LANGUAGE_HI_IN
        bool "Hindi"
        # Tiếng Hindi (Ấn Độ)
        # Hindi (India)
    config LANGUAGE_PT_PT
        bool "Portuguese"
        # Tiếng Bồ Đào Nha
        # Portuguese
    config LANGUAGE_PL_PL
        bool "Polish"
        # Tiếng Ba Lan
        # Polish
    config LANGUAGE_CS_CZ
        bool "Czech"
        # Tiếng Séc
        # Czech
    config LANGUAGE_FI_FI
        bool "Finnish"
        # Tiếng Phần Lan
        # Finnish
    config LANGUAGE_TR_TR
        bool "Turkish"
        # Tiếng Thổ Nhĩ Kỳ
        # Turkish
    config LANGUAGE_ID_ID
        bool "Indonesian"
        # Tiếng Indonesia
        # Indonesian
    config LANGUAGE_UK_UA
        bool "Ukrainian"
        # Tiếng Ukraina
        # Ukrainian
    config LANGUAGE_RO_RO
        bool "Romanian"
        # Tiếng Rumani
        # Romanian
endchoice

# Lựa chọn loại board (mạch phát triển) đang sử dụng
# Board type selection for hardware configuration
choice BOARD_TYPE
    prompt "Board Type"
    default BOARD_TYPE_BREAD_COMPACT_WIFI
    help
        Board type. (Loại bảng phát triển)
        # Chọn loại board phát triển. Điều này quan trọng để định cấu hình đúng các chân GPIO và ngoại vi.
        # Select development board type. This is important for correct GPIO and peripheral configuration.
    config BOARD_TYPE_BREAD_COMPACT_WIFI
        bool "Bread Compact WiFi (Breadboard)"
        # Board cơ bản với WiFi, sử dụng ESP32-S3
        # Basic board with WiFi, uses ESP32-S3
        depends on IDF_TARGET_ESP32S3
    config BOARD_TYPE_BREAD_COMPACT_WIFI_LCD
        bool "Bread Compact WiFi + LCD (Breadboard)"
        # Board với WiFi và màn hình LCD, sử dụng ESP32-S3
        # Board with WiFi and LCD display, uses ESP32-S3
        depends on IDF_TARGET_ESP32S3
    config BOARD_TYPE_BREAD_COMPACT_WIFI_CAM
        bool "Bread Compact WiFi + LCD + Camera (Breadboard)"
        # Board đầy đủ với WiFi, LCD và Camera, sử dụng ESP32-S3
        # Full-featured board with WiFi, LCD and Camera, uses ESP32-S3
        depends on IDF_TARGET_ESP32S3     
    config BOARD_TYPE_BREAD_COMPACT_ML307
        bool "Bread Compact ML307/EC801E (Breadboard 4G)"
        depends on IDF_TARGET_ESP32S3
    config BOARD_TYPE_BREAD_COMPACT_ESP32
        bool "Bread Compact ESP32 DevKit (Breadboard)"
