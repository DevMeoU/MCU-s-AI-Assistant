choice ESP_S3_LCD_EV_Board_Version_TYPE
    depends on BOARD_TYPE_ESP_S3_LCD_EV_Board
    prompt "EV_BOARD Type"
    default ESP_S3_LCD_EV_Board_1p4
    config ESP_S3_LCD_EV_Board_1p4
        bool "Lexin ESP32_S3_LCD_EV_Board-MB_V1.4 (Lexin ESP32_S3_LCD_EV_Board-MB_V1.4)"
    config ESP_S3_LCD_EV_Board_1p5
        bool "Lexin ESP32_S3_LCD_EV_Board-MB_V1.5 (Lexin ESP32_S3_LCD_EV_Board-MB_V1.5)"
endchoice

# Lựa chọn loại màn hình OLED đơn sắc
# OLED display type selection for monochrome screens
choice DISPLAY_OLED_TYPE
    depends on BOARD_TYPE_BREAD_COMPACT_WIFI || BOARD_TYPE_BREAD_COMPACT_ML307 || BOARD_TYPE_BREAD_COMPACT_ESP32
    prompt "OLED Type"
    default OLED_SSD1306_128X32
    help
        OLED Monochrome Display Type
        # Loại màn hình OLED đơn sắc. Lựa chọn này ảnh hưởng đến thư viện driver và độ phân giải.
        # OLED monochrome display type. This affects driver library and resolution.
    config OLED_SSD1306_128X32
        bool "SSD1306 128*32"
        # SSD1306 với độ phân giải 128x32 pixel - Kích thước nhỏ gọn
        # SSD1306 with 128x32 pixel resolution - Compact size
    config OLED_SSD1306_128X64
        bool "SSD1306 128*64"
        # SSD1306 với độ phân giải 128x64 pixel - Kích thước phổ biến
        # SSD1306 with 128x64 pixel resolution - Common size
    config OLED_SH1106_128X64
        bool "SH1106 128*64"
        # SH1106 với độ phân giải 128x64 pixel - Driver khác với SSD1306
        # SH1106 with 128x64 pixel resolution - Different driver from SSD1306
endchoice

# Lựa chọn loại màn hình LCD màu
# LCD color display type selection
choice DISPLAY_LCD_TYPE
    depends on BOARD_TYPE_BREAD_COMPACT_WIFI_LCD || BOARD_TYPE_BREAD_COMPACT_ESP32_LCD || BOARD_TYPE_ESP32_CGC || BOARD_TYPE_ESP32P4_NANO || BOARD_TYPE_ESP32P4_WIFI6_Touch_LCD_XC || BOARD_TYPE_BREAD_COMPACT_WIFI_CAM
    prompt "LCD Type"
    default LCD_ST7789_240X320
    help
        LCD Display Type
        # Loại màn hình LCD màu. Lựa chọn driver phù hợp với màn hình đang sử dụng.
        # LCD color display type. Choose appropriate driver for your display.
    config LCD_ST7789_240X320
        bool "ST7789 240*320, IPS"
    config LCD_ST7789_240X320_NO_IPS
        bool "ST7789 240*320, Non-IPS"
    config LCD_ST7789_170X320
        bool "ST7789 170*320"
    config LCD_ST7789_172X320
        bool "ST7789 172*320"
    config LCD_ST7789_240X280
        bool "ST7789 240*280"
    config LCD_ST7789_240X240
        bool "ST7789 240*240"
    config LCD_ST7789_240X240_7PIN
        bool "ST7789 240*240, 7PIN"
    config LCD_ST7789_240X135
        bool "ST7789 240*135"
    config LCD_ST7735_128X160
        bool "ST7735 128*160"
    config LCD_ST7735_128X128
        bool "ST7735 128*128"
    config LCD_ST7796_320X480
        bool "ST7796 320*480 IPS"
    config LCD_ST7796_320X480_NO_IPS
        bool "ST7796 320*480, Non-IPS"
    config LCD_ILI9341_240X320
        bool "ILI9341 240*320"
    config LCD_ILI9341_240X320_NO_IPS
        bool "ILI9341 240*320, Non-IPS"
    config LCD_GC9A01_240X240
        bool "GC9A01 240*240 Circle"
    config LCD_TYPE_800_1280_10_1_INCH
        bool "Waveshare 101M-8001280-IPS-CT-K Display"
    config LCD_TYPE_800_1280_10_1_INCH_A
        bool "Waveshare 10.1-DSI-TOUCH-A Display"
    config LCD_TYPE_800_800_3_4_INCH
        bool "Waveshare ESP32-P4-WIFI6-Touch-LCD-3.4C with 800*800 3.4inch round display"
    config LCD_TYPE_720_720_4_INCH
        bool "Waveshare ESP32-P4-WIFI6-Touch-LCD-4C with 720*720 4inch round display"
    config LCD_CUSTOM
        bool "Custom LCD (Tham số màn hình tùy chỉnh)"
endchoice

choice DISPLAY_ESP32S3_KORVO2_V3
    depends on BOARD_TYPE_ESP32S3_KORVO2_V3
    prompt "ESP32S3_KORVO2_V3 LCD Type"
    default ESP32S3_KORVO2_V3_LCD_ST7789
    help
        LCD Display Type
    config ESP32S3_KORVO2_V3_LCD_ST7789
        bool "ST7789 240*280"
    config ESP32S3_KORVO2_V3_LCD_ILI9341
        bool "ILI9341 240*320"
endchoice

choice DISPLAY_ESP32S3_AUDIO_BOARD
    depends on BOARD_TYPE_ESP32S3_AUDIO_BOARD
    prompt "ESP32S3_AUDIO_BOARD LCD Type"
    default AUDIO_BOARD_LCD_JD9853
    help
        LCD Display Type
    config AUDIO_BOARD_LCD_JD9853
        bool "JD9853 320*172"
    config AUDIO_BOARD_LCD_ST7789
        bool "ST7789 240*320"
endchoice

# Lựa chọn kiểu hiển thị giao diện cho thiết bị Xiaozhi
# Display style selection for Xiaozhi device interface
choice DISPLAY_STYLE
    prompt "Select display style"
    default USE_DEFAULT_MESSAGE_STYLE
    help
        Select display style for Xiaozhi device
        # Lựa chọn kiểu hiển thị cho thiết bị Xiaozhi.
        # Kiểu hiển thị ảnh cách bố trí và trình bày thông tin trên màn hình.

    config USE_DEFAULT_MESSAGE_STYLE
        bool "Enable default message style"
        # Kiểu mặc định - Giao diện cơ bản và đơn giản
        # Default style - Basic and simple interface

    config USE_WECHAT_MESSAGE_STYLE
        bool "Enable WeChat Message Style"
        # Kiểu giống WeChat - Giao diện quen thuộc như ứng dụng chat
        # WeChat-like style - Familiar chat application interface

    config USE_EMOTE_MESSAGE_STYLE
        bool "Emote animation style"
        # Kiểu biểu cảm - Có hoạt ảnh và biểu tượng cảm xúc
        # Emote animation style - With animations and emoticons
        depends on BOARD_TYPE_ESP_BOX_3 || BOARD_TYPE_ECHOEAR
endchoice

# Lựa chọn kiểu triển khai từ đánh thức (Wake Word)
# Wake word implementation type selection
choice WAKE_WORD_TYPE
    prompt "Wake Word Implementation Type"
    default USE_AFE_WAKE_WORD if (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
    default WAKE_WORD_DISABLED
    help
        Choose the type of wake word implementation to use
        # Lựa chọn kiểu triển khai từ đánh thức để sử dụng.
        # Từ đánh thức cho phép thiết bị "nghe" và đánh thức khi nghe thấy từ khóa.

    config WAKE_WORD_DISABLED
        bool "Disabled"
        help
            Disable wake word detection
            # Tắt chức năng phát hiện từ đánh thức - Tiết kiệm tài nguyên
            # Disable wake word detection - Save resources

    config USE_ESP_WAKE_WORD
        bool "Wakenet model without AFE"
        depends on IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C5 || IDF_TARGET_ESP32C6 || (IDF_TARGET_ESP32 && SPIRAM)
        help
            Hỗ trợ ESP32 C3, ESP32 C5 và ESP32 C6, và (ESP32 với PSRAM)
            # Mô hình Wakenet không có AFE - Hỗ trợ ESP32-C3, C5, C6 và ESP32 với PSRAM
            # Wakenet model without AFE - Support ESP32-C3, C5, C6 and ESP32 with PSRAM

    config USE_AFE_WAKE_WORD
        bool "Wakenet model with AFE"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
        help
            Support AEC if available, requires ESP32 S3 and PSRAM
            # Mô hình Wakenet với AFE (Audio Front-End) - Hỗ trợ AEC nếu có, yêu cầu ESP32-S3 và PSRAM
            # Wakenet model with AFE - Support AEC if available, requires ESP32-S3 and PSRAM

    config USE_CUSTOM_WAKE_WORD
        bool "Multinet model (Custom Wake Word)"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
        help
            Requires ESP32 S3 and PSRAM
            # Mô hình Multinet với từ đánh thức tùy chỉnh - Yêu cầu ESP32-S3 và PSRAM
            # Multinet model with custom wake word - Requires ESP32-S3 and PSRAM

endchoice

# Cấu hình từ đánh thức tùy chỉnh
# Custom wake word configuration
config CUSTOM_WAKE_WORD
    string "Custom Wake Word"
    default "xiao tu dou"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Custom Wake Word, use pinyin for Chinese, separated by spaces
        # Từ đánh thức tùy chỉnh. Sử dụng phiên âm Pinyin cho tiếng Trung, cách nhau bằng khoảng trắng.
        # Ví dụ: "xin chao" cho "xin chào" hoặc "hello" cho tiếng Anh.

config CUSTOM_WAKE_WORD_DISPLAY
    string "Custom Wake Word Display"
    default "Khoai tây nhỏ"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Greeting sent to the server after wake word detection
        # Lời chào được gửi đến máy chủ sau khi phát hiện từ đánh thức.
        # Đây là văn bản sẽ hiển thị khi thiết bị được đánh thức thành công.

config CUSTOM_WAKE_WORD_THRESHOLD
    int "Custom Wake Word Threshold (%)"
    default 20
    range 1 99
    depends on USE_CUSTOM_WAKE_WORD
    help
        Custom Wake Word Threshold, range 1-99, the smaller the more sensitive, default 20
        # Ngưỡng phát hiện từ đánh thức tùy chỉnh. Phạm vi 1-99, giá trị nhỏ thì nhạy hơn, mặc định là 20.
        # Ngưỡng thấp = nhạy hơn nhưng dễ bị kích hoạt nhầm. Ngưỡng cao = chính xác hơn nhưng cần nói to rõ ràng.

config SEND_WAKE_WORD_DATA
    bool "Send Wake Word Data"
    default y
    depends on USE_AFE_WAKE_WORD || USE_CUSTOM_WAKE_WORD
    help
        Send wake word data to the server as the first message of the conversation and wait for response
        # Gửi dữ liệu từ đánh thức đến máy chủ như tin nhắn đầu tiên của cuộc hội thoại và chờ phản hồi.
        # Cho phép máy chủ biết thiết bị đã được đánh thức và sẵn sàng nhận lệnh.
        
# Bộ xử lý âm thanh - Giảm nhiễu và xử lý tín hiệu
# Audio processor - Noise reduction and signal processing
config USE_AUDIO_PROCESSOR
    bool "Enable Audio Noise Reduction"
    default y
    depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
    help
        Requires ESP32 S3 and PSRAM
        # Kích hoạt bộ xử lý âm thanh để giảm nhiễu và cải thiện chất lượng âm thanh.
        # Yêu cầu ESP32-S3 và PSRAM để xử lý thời gian thực.
        # Enable audio processor for noise reduction and audio quality improvement.
        # Requires ESP32-S3 and PSRAM for real-time processing.

# AEC (Acoustic Echo Cancellation) phía thiết bị
# Device-side Acoustic Echo Cancellation
config USE_DEVICE_AEC
    bool "Enable Device-Side AEC"
    default n
        depends on USE_AUDIO_PROCESSOR && (BOARD_TYPE_ESP_BOX_3 || BOARD_TYPE_ESP_BOX || BOARD_TYPE_ESP_BOX_LITE \
        || BOARD_TYPE_LICHUANG_DEV || BOARD_TYPE_ESP32S3_KORVO2_V3 || BOARD_TYPE_ESP32S3_Touch_AMOLED_1_75 \
        || BOARD_TYPE_ESP32S3_Touch_AMOLED_2_06 || BOARD_TYPE_ESP32S3_Touch_LCD_4B || BOARD_TYPE_ESP32P4_WIFI6_Touch_LCD_4B \
        || BOARD_TYPE_ESP32P4_WIFI6_Touch_LCD_XC || BOARD_TYPE_ESP_S3_LCD_EV_Board_2 || BOARD_TYPE_YUNLIAO_S3 \
        || BOARD_TYPE_ECHOEAR || BOARD_TYPE_ESP32S3_Touch_LCD_3_49)
    help
        To work properly, device-side AEC requires a clean output reference path from the speaker signal and physical acoustic isolation between the microphone and speaker.
        # AEC phía thiết bị - Loại bỏ tiếng vọng từ loa vào microphone.
        # Cần đường tín hiệu tham khảo sạch từ loa và cách ly vật lý giữa mic và loa.
        # Device-side AEC - Removes echo from speaker to microphone.
        # Requires clean reference path from speaker and physical isolation.

# AEC phía máy chủ (chưa ổn định)
# Server-side Acoustic Echo Cancellation (unstable)
config USE_SERVER_AEC
    bool "Enable Server-Side AEC (Unstable)"
    default n
    depends on USE_AUDIO_PROCESSOR
    help
        To work perperly, server-side AEC requires server support
        # AEC phía máy chủ - Xử lý loại bỏ tiếng vọng trên máy chủ (tính năng chưa ổn định).
        # Yêu cầu máy chủ hỗ trợ xử lý âm thanh thời gian thực.
        # Server-side AEC - Echo cancellation processed on server (unstable feature).
        # Requires server support for real-time audio processing.

# Bộ gỡ lỗi âm thanh - Gửi dữ liệu âm thanh qua UDP
# Audio debugger - Send audio data through UDP
config USE_AUDIO_DEBUGGER
    bool "Enable Audio Debugger"
    default n
    help
        Enable audio debugger, send audio data through UDP to the host machine
        # Kích hoạt bộ gỡ lỗi âm thanh - Gửi dữ liệu âm thanh thời gian thực qua UDP đến máy tính.
        # Hữu ích để phân tích và gỡ lỗu chất lượng âm thanh, tiếng ồn, hay các vấn đề về nhận dạng giọng nói.
        # Enable audio debugger - Send real-time audio data via UDP to host computer.
        # Useful for analyzing and debugging audio quality, noise, or speech recognition issues.

# Địa chỉ máy chủ UDP cho gỡ lỗi âm thanh
# UDP server address for audio debugging
config AUDIO_DEBUG_UDP_SERVER
    string "Audio Debug UDP Server Address"
    default "192.168.2.100:8000"
    depends on USE_AUDIO_DEBUGGER
    help
        UDP server address, format: IP:PORT, used to receive audio debugging data
        # Địa chỉ máy chủ UDP để nhận dữ liệu gỡ lỗi âm thanh. Định dạng: IP:PORT.
        # Ví dụ: "192.168.1.100:8000" - IP của máy tính chạy phần mềm gỡ lỗi.
        # UDP server address format: IP:PORT for receiving audio debug data.
        # Example: "192.168.1.100:8000" - IP of computer running debug software.

# Cấu hình WiFi qua âm thanh - Truyền dữ liệu WiFi bằng tín hiệu âm
# Acoustic WiFi provisioning - Transmit WiFi data using audio signals
config USE_ACOUSTIC_WIFI_PROVISIONING
    bool "Enable Acoustic WiFi Provisioning"
    default n
    help
        Enable acoustic WiFi provisioning, use audio signal to transmit WiFi configuration data
        # Kích hoạt cấu hình WiFi qua âm thanh - Sử dụng tín hiệu âm để truyền dữ liệu cấu hình WiFi.
        # Hữu ích khi không có màn hình hoặc giao diện người dùng, chỉ cần phát âm thanh từ điện thoại.
        # Enable acoustic WiFi provisioning - Use audio signals to transmit WiFi configuration data.
        # Useful when no screen or UI is available, just play audio from phone.

# Nhận tin nhắn tùy chỉnh từ máy chủ
# Receive custom messages from server
config RECEIVE_CUSTOM_MESSAGE
    bool "Enable Custom Message Reception"
    default n
    help
        Enable custom message reception, allow the device to receive custom messages from the server (preferably through the MQTT protocol)
        # Kích hoạt nhận tin nhắn tùy chỉnh từ máy chủ - Thường qua giao thức MQTT.
        # Cho phép thiết bị nhận các lệnh hoặc thông điệp đặc biệt từ máy chủ điều khiển.
        # Enable custom message reception from server - Usually via MQTT protocol.
        # Allows device to receive special commands or messages from control server.

# Lựa chọn kiểu giao tiếp I2S cho board Taiji Pi S3
# I2S communication type selection for Taiji Pi S3 board
choice I2S_TYPE_TAIJIPI_S3
    depends on BOARD_TYPE_ESP32S3_Taiji_Pi
    prompt "taiji-pi-S3 I2S Type"
    default TAIJIPAI_I2S_TYPE_STD
    help
        I2S Type
        # Lựa chọn kiểu giao tiếp I2S (Inter-IC Sound) cho board Taiji Pi S3.
        # STD: Chuẩn I2S truyền thống, PDM: Pulse Density Modulation cho microphone kỹ thuật số.
        # Select I2S (Inter-IC Sound) communication type for Taiji Pi S3 board.
        # STD: Standard I2S, PDM: Pulse Density Modulation for digital microphones.
    config TAIJIPAI_I2S_TYPE_STD
        bool "I2S Type STD"
        # I2S chuẩn - Giao tiếp âm thanh nổi tiếng, phù hợp cho hầu hết thiết bị ngoại vi.
        # Standard I2S - Popular audio communication, suitable for most peripherals.
    config TAIJIPAI_I2S_TYPE_PDM
        bool "I2S Type PDM"
        # PDM - Dành cho microphone kỹ thuật số, đơn giản hóa thiết kế phần cứng.
        # PDM - For digital microphones, simplifies hardware design.
endchoice

endmenu
